{
  "name": "azeroth-control",
  "version": "0.1.0",
  "description": "Gamepad-friendly Steam Deck and SteamOS installer and control center for AzerothCore Playerbots",
  "author": "Raanh and Azeroth Control contributors",
  "license": "MIT",
  "homepage": "https://github.com/raanh/azeroth-control",
  "repository": {
    "type": "git",
    "url": "https://github.com/raanh/azeroth-control.git"
  },
  "bugs": {
    "url": "https://github.com/raanh/azeroth-control/issues"
  },
  "desktopName": "org.azerothcontrol.app",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "electron electron/main.cjs",
    "appimage": "npm run build && electron-builder --linux AppImage --x64",
    "appimage:dir": "npm run build && electron-builder --linux dir --x64",
    "start": "vite preview",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260823.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "org.azerothcontrol.app",
    "productName": "Azeroth Control",
    "directories": {
      "output": "release"
    },
    "artifactName": "Azeroth-Control-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "manifests",
        "to": "manifests"
      },
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "scripts/install-server.sh",
        "to": "scripts/install-server.sh"
      },
      {
        "from": "scripts/server-control-managed",
        "to": "scripts/server-control-managed"
      },
      {
        "from": "scripts/launch-wow-managed",
        "to": "scripts/launch-wow-managed"
      },
      {
        "from": "scripts/autologin-managed",
        "to": "scripts/autologin-managed"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "syncDesktopName": true,
      "synopsis": "SteamOS control center for AzerothCore Playerbots"
    }
  }
}
