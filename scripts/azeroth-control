#!/usr/bin/env bash
set -Eeuo pipefail

APP_ROOT="$HOME/Applications/azeroth-control"
URL="http://127.0.0.1:8742"
SERVER_PID=""

if ! curl -fsS "$URL/api/status" >/dev/null 2>&1; then
    mkdir -p "$APP_ROOT/logs"
    python3 "$APP_ROOT/backend/server.py" >>"$APP_ROOT/logs/control.log" 2>&1 &
    SERVER_PID="$!"
    for _ in $(seq 1 50); do
        curl -fsS "$URL/api/status" >/dev/null 2>&1 && break
        sleep 0.1
    done
fi

if ! curl -fsS "$URL/api/status" >/dev/null 2>&1; then
    printf 'Azeroth Control backend did not start. See %s/logs/control.log\n' "$APP_ROOT" >&2
    exit 1
fi

cleanup() {
    if [[ -n "$SERVER_PID" ]]; then
        kill "$SERVER_PID" >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

flatpak run com.google.Chrome \
    --app="$URL" \
    --start-fullscreen \
    --no-first-run \
    --disable-session-crashed-bubble \
    --disable-features=Translate
