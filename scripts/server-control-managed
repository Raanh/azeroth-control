#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/install.env"
PROVIDER_ID="${PROVIDER_ID:-azerothcore-playerbots}"
SUPPORTS_BOTS="${SUPPORTS_BOTS:-1}"
AUTOBALANCE_ENABLED="${AUTOBALANCE_ENABLED:-0}"
TOOLS_IMAGE="${TOOLS_IMAGE:-}"
RUNTIME="$ROOT/runtime"
MODULES_DIR="$RUNTIME/modules"
case "$REALM_KEY" in
    progression) CONFIG_DIR="$RUNTIME/etc"; LOG_DIR="$RUNTIME/logs" ;;
    endgame) CONFIG_DIR="$RUNTIME/endgame/etc"; LOG_DIR="$RUNTIME/endgame/logs" ;;
    qa) CONFIG_DIR="$RUNTIME/qa/etc"; LOG_DIR="$RUNTIME/qa/logs" ;;
    coa) CONFIG_DIR="$RUNTIME/etc"; LOG_DIR="$RUNTIME/logs" ;;
    *) printf 'Unsupported managed realm: %s\n' "$REALM_KEY" >&2; exit 2 ;;
esac
NETWORK="${CONTAINER_PREFIX}-network"
DB_VOLUME="${CONTAINER_PREFIX}-database-data"
DATA_VOLUME="${CONTAINER_PREFIX}-client-data"
DB_CONTAINER="${CONTAINER_PREFIX}-database"
AUTH_CONTAINER="${CONTAINER_PREFIX}-authserver"
WORLD_CONTAINER="${CONTAINER_PREFIX}-worldserver"
DB_INFO="$DB_CONTAINER;3306;root;$DB_PASSWORD"

port_ready() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
remove_container() { podman rm -f "$1" >/dev/null 2>&1 || true; }

install_coa_client_dbc() {
    [[ "$PROVIDER_ID" == azerothcore-coa ]] || return 0
    [[ -n "$TOOLS_IMAGE" ]] || { printf 'CoA client-data extractor image is missing. Resume the installation with the current Azeroth Control release.\n' >&2; return 1; }
    [[ -d "$CLIENT_PATH/Data" ]] || { printf 'The configured CoA client Data directory is missing: %s\n' "$CLIENT_PATH/Data" >&2; return 1; }
    [[ -f "$ROOT/state/coa-client-dbc-installed" ]] && return 0

    # The downloaded stock server data is enough for an ordinary WotLK realm,
    # but CoA needs the matching custom Spell.dbc and related files from the
    # user's Ascension client. Extract into a fresh managed staging directory;
    # only copy it into the live data volume after Spell.dbc was produced.
    local extract_root
    extract_root="$(mktemp -d "$ROOT/state/coa-client-dbc.XXXXXX")"
    printf 'Extracting matching CoA DBC files from the selected Ascension client…\n'
    podman run --rm --userns=keep-id --entrypoint /bin/bash \
        -v "$CLIENT_PATH:/client:ro" -v "$extract_root:/output" "$TOOLS_IMAGE" -lc '
            set -Eeuo pipefail
            test -d /client/Data
            /azerothcore/env/dist/bin/map_extractor -e 2 -i /client -o /output
            test -s /output/dbc/Spell.dbc
        '
    podman run --rm --userns=keep-id --entrypoint /bin/bash \
        -v "$DATA_VOLUME:/azerothcore/env/dist/data" -v "$extract_root:/input:ro" "$TOOLS_IMAGE" -lc '
            set -Eeuo pipefail
            test -s /input/dbc/Spell.dbc
            mkdir -p /azerothcore/env/dist/data/dbc
            cp -a /input/dbc/. /azerothcore/env/dist/data/dbc/
            test -s /azerothcore/env/dist/data/dbc/Spell.dbc
        '
    touch "$ROOT/state/coa-client-dbc-installed"
}

set_conf_value() {
    local path="$1" key="$2" value="$3"
    python3 - "$path" "$key" "$value" <<'PY'
from pathlib import Path
import re, sys
path, key, value = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
text = path.read_text()
pattern = re.compile(r"^(\s*" + re.escape(key) + r"\s*=\s*).*$", re.MULTILINE)
if not pattern.search(text):
    raise SystemExit("Missing configuration key: " + key)
temporary = path.with_suffix(path.suffix + ".tmp")
temporary.write_text(pattern.sub(lambda match: match.group(1) + value, text, count=1))
temporary.replace(path)
PY
}

stop_server() {
    podman stop -t 60 "$WORLD_CONTAINER" "$AUTH_CONTAINER" >/dev/null 2>&1 || true
    podman stop -t 30 "$DB_CONTAINER" >/dev/null 2>&1 || true
    for name in "$WORLD_CONTAINER" "$AUTH_CONTAINER" "$DB_CONTAINER" "${CONTAINER_PREFIX}-db-import" "${CONTAINER_PREFIX}-client-data-init"; do
        remove_container "$name"
    done
}

start_server() {
    local coa_client_dbc_ready=1
    if [[ "$PROVIDER_ID" == azerothcore-coa && ! -f "$ROOT/state/coa-client-dbc-installed" ]]; then
        coa_client_dbc_ready=0
    fi
    if port_ready 3724 && port_ready "$WORLD_PORT" \
       && [[ "$coa_client_dbc_ready" == 1 ]]; then
        printf '%s is already online.\n' "$REALM_NAME"
        return 0
    fi
    # A busy worldserver (especially with hundreds of PlayerBots) may briefly
    # stop accepting new sockets. Never tear a healthy realm down merely
    # because one readiness probe happened during that pause.
    if [[ "$(podman inspect -f '{{.State.Status}}' "$DB_CONTAINER" 2>/dev/null || true)" == running \
       && "$(podman inspect -f '{{.State.Status}}' "$AUTH_CONTAINER" 2>/dev/null || true)" == running \
       && "$(podman inspect -f '{{.State.Status}}' "$WORLD_CONTAINER" 2>/dev/null || true)" == running \
       && "$coa_client_dbc_ready" == 1 ]]; then
        for _ in $(seq 1 40); do
            if port_ready 3724 && port_ready "$WORLD_PORT"; then
                printf '%s is already online.\n' "$REALM_NAME"
                return 0
            fi
            sleep 0.5
        done
        printf '%s is running but temporarily busy; leaving it untouched.\n' "$REALM_NAME"
        return 0
    fi
    mkdir -p "$CONFIG_DIR" "$LOG_DIR" "$MODULES_DIR"
    if [[ "$SUPPORTS_BOTS" == 1 ]]; then
        mkdir -p "$MODULES_DIR/mod-playerbots/data/sql"
    fi
    podman network exists "$NETWORK" || podman network create "$NETWORK" >/dev/null
    podman volume exists "$DB_VOLUME" || podman volume create "$DB_VOLUME" >/dev/null
    podman volume exists "$DATA_VOLUME" || podman volume create "$DATA_VOLUME" >/dev/null
    stop_server

    # Database access is private to this installation's Podman network. The
    # host does not need a published MySQL port; publishing 3307 made otherwise
    # independent installations collide with each other and local databases.
    podman run -d --name "$DB_CONTAINER" --restart=unless-stopped --network "$NETWORK" --network-alias "$DB_CONTAINER" -e "MYSQL_ROOT_PASSWORD=$DB_PASSWORD" -v "$DB_VOLUME:/var/lib/mysql" docker.io/library/mysql:8.4 >/dev/null
    for _ in $(seq 1 90); do
        podman exec "$DB_CONTAINER" mysqladmin ping -uroot -p"$DB_PASSWORD" --silent >/dev/null 2>&1 && break
        sleep 2
    done
    podman exec "$DB_CONTAINER" mysqladmin ping -uroot -p"$DB_PASSWORD" --silent >/dev/null 2>&1 || { podman logs --tail 100 "$DB_CONTAINER" >&2; return 1; }

    if [[ "$PROVIDER_ID" == azerothcore-coa ]]; then
        podman exec "$DB_CONTAINER" mysql -uroot -p"$DB_PASSWORD" -e "CREATE DATABASE IF NOT EXISTS acore_world CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
        world_tables="$(podman exec "$DB_CONTAINER" mysql -N -uroot -p"$DB_PASSWORD" -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='acore_world'" | tr -d '[:space:]')"
        if [[ "$world_tables" == 0 ]]; then
            printf 'Importing the verified CoA world-content baseline…\n'
            python3 "$ROOT/core/apps/coa-world/world_data.py" verify
            python3 "$ROOT/core/apps/coa-world/world_data.py" bootstrap --mysql "$ROOT/bin/coa-mysql" --database acore_world
            touch "$ROOT/state/coa-world-bootstrap"
        elif [[ ! -f "$ROOT/state/coa-world-bootstrap" ]]; then
            printf 'The CoA world database is non-empty but has no managed bootstrap marker. Refusing to overwrite it.\n' >&2
            return 1
        fi
    elif [[ "$SUPPORTS_BOTS" == 1 ]]; then
        podman exec "$DB_CONTAINER" mysql -uroot -p"$DB_PASSWORD" -e "CREATE DATABASE IF NOT EXISTS $PLAYERBOTS_DB CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
    fi

    # The CoA provider imports a verified, versioned world baseline before
    # AzerothCore's db-import container runs. Its migration ledger already
    # records the updates included by that baseline; applying the repository's
    # newer pending world updates on top can mix incompatible schemas. Keep
    # auth (1) and character (2) updates enabled, but leave world (4) to the
    # CoA baseline until upstream publishes a matching refreshed baseline.
    updates_enable_databases=7
    if [[ "$PROVIDER_ID" == azerothcore-coa ]]; then
        updates_enable_databases=3
    fi
    podman run --rm --name "${CONTAINER_PREFIX}-client-data-init" -v "$DATA_VOLUME:/azerothcore/env/dist/data" "$DATA_IMAGE"
    install_coa_client_dbc
    import_args=(--rm --name "${CONTAINER_PREFIX}-db-import" --userns=keep-id --network "$NETWORK"
        -e AC_DATA_DIR=/azerothcore/env/dist/data -e AC_LOGS_DIR=/azerothcore/env/dist/logs
        -e "AC_UPDATES_ENABLE_DATABASES=$updates_enable_databases"
        -e "AC_LOGIN_DATABASE_INFO=$DB_INFO;acore_auth" -e "AC_WORLD_DATABASE_INFO=$DB_INFO;acore_world"
        -e "AC_CHARACTER_DATABASE_INFO=$DB_INFO;$CHARACTER_DB"
        -v "$CONFIG_DIR:/azerothcore/env/dist/etc" -v "$LOG_DIR:/azerothcore/env/dist/logs")
    if [[ "$SUPPORTS_BOTS" == 1 ]]; then
        import_args+=(-e "AC_PLAYERBOTS_DATABASE_INFO=$DB_INFO;$PLAYERBOTS_DB" -e AC_PLAYERBOTS_UPDATES_ENABLE_DATABASES=1)
    fi
    podman run "${import_args[@]}" "$IMPORT_IMAGE"
    if [[ "$SUPPORTS_BOTS" == 1 ]]; then
        podman run --rm --userns=keep-id --entrypoint /bin/bash -v "$MODULES_DIR:/export" "$IMPORT_IMAGE" -lc 'mkdir -p /export/mod-playerbots/data/sql && cp -a /azerothcore/modules/mod-playerbots/data/sql/. /export/mod-playerbots/data/sql/'
    fi

    if [[ -d "$CONFIG_DIR/modules" ]]; then
        while IFS= read -r -d '' source_config; do
            target_config="${source_config%.dist}"
            [[ -e "$target_config" ]] || cp "$source_config" "$target_config"
        done < <(find "$CONFIG_DIR/modules" -maxdepth 1 -type f -name '*.conf.dist' -print0)
    fi
    if [[ "$PROVIDER_ID" == azerothcore-coa ]]; then
        ascension_config="$CONFIG_DIR/modules/mod_ascension_compat.conf"
        [[ -f "$ascension_config" ]] || { printf 'CoA compatibility configuration is missing.\n' >&2; return 1; }
        set_conf_value "$ascension_config" AscensionCompat.DbcDirectory '"/azerothcore/env/dist/data/dbc"'
        if [[ "$AUTOBALANCE_ENABLED" == 1 ]]; then
            autobalance_config="$CONFIG_DIR/modules/AutoBalance.conf"
            [[ -f "$autobalance_config" ]] || { printf 'AutoBalance was selected but its configuration was not installed.\n' >&2; return 1; }
            if [[ ! -f "$ROOT/state/autobalance-configured" ]]; then
                set_conf_value "$autobalance_config" AutoBalance.Enable.Global 1
                set_conf_value "$autobalance_config" AutoBalance.MinPlayers 1
                set_conf_value "$autobalance_config" AutoBalance.MinPlayers.Heroic 1
                set_conf_value "$autobalance_config" AutoBalance.MinPlayers.Raid 1
                set_conf_value "$autobalance_config" AutoBalance.MinPlayers.RaidHeroic 1
                touch "$ROOT/state/autobalance-configured"
            fi
            autobalance_state="$(sed -n 's/^[[:space:]]*AutoBalance.Enable.Global[[:space:]]*=[[:space:]]*//p' "$autobalance_config" | tail -n 1 | tr -d '[:space:]')"
            # Avoid stacking two independent creature-scaling systems. Turning
            # AutoBalance off in the UI restores CoA's original level scaler.
            if [[ "$autobalance_state" == 1 ]]; then
                set_conf_value "$ascension_config" AscensionCompat.LevelScaling 0
            else
                set_conf_value "$ascension_config" AscensionCompat.LevelScaling 1
            fi
        fi
    fi
    podman exec "$DB_CONTAINER" mysql -uroot -p"$DB_PASSWORD" acore_auth -e "INSERT INTO realmlist (id,name,address,localAddress,localSubnetMask,port,icon,flag,timezone,allowedSecurityLevel,population,gamebuild) VALUES (1,'$REALM_NAME','127.0.0.1','127.0.0.1','255.255.255.0',$WORLD_PORT,0,0,1,0,0,12340) ON DUPLICATE KEY UPDATE name=VALUES(name),port=VALUES(port),flag=0,gamebuild=12340"

    podman run -d --name "$AUTH_CONTAINER" --restart=unless-stopped --userns=keep-id --network "$NETWORK" -p 127.0.0.1:3724:3724 -e AC_LOGS_DIR=/azerothcore/env/dist/logs -e "AC_LOGIN_DATABASE_INFO=$DB_INFO;acore_auth" -v "$CONFIG_DIR:/azerothcore/env/dist/etc" -v "$LOG_DIR:/azerothcore/env/dist/logs" "$AUTH_IMAGE" >/dev/null
    world_args=(-di --name "$WORLD_CONTAINER" --restart=unless-stopped --userns=keep-id --network "$NETWORK"
        -p "127.0.0.1:$WORLD_PORT:8085" -p 127.0.0.1:7878:7878
        -e AC_DISABLE_INTERACTIVE=0 -e AC_DATA_DIR=/azerothcore/env/dist/data -e AC_LOGS_DIR=/azerothcore/env/dist/logs
        -e "AC_UPDATES_ENABLE_DATABASES=$updates_enable_databases" -e "AC_LOGIN_DATABASE_INFO=$DB_INFO;acore_auth"
        -e "AC_WORLD_DATABASE_INFO=$DB_INFO;acore_world" -e "AC_CHARACTER_DATABASE_INFO=$DB_INFO;$CHARACTER_DB"
        -e "AC_START_PLAYER_LEVEL=$START_LEVEL" -v "$CONFIG_DIR:/azerothcore/env/dist/etc"
        -v "$LOG_DIR:/azerothcore/env/dist/logs" -v "$DATA_VOLUME:/azerothcore/env/dist/data:ro"
        -v "$MODULES_DIR:/azerothcore/modules:ro")
    if [[ "$SUPPORTS_BOTS" == 1 ]]; then
        world_args+=(-e "AC_PLAYERBOTS_DATABASE_INFO=$DB_INFO;$PLAYERBOTS_DB" -e AC_PLAYERBOTS_UPDATES_ENABLE_DATABASES=1
            -e AC_AI_PLAYERBOT_RANDOM_BOT_AUTOLOGIN=1 -e "AC_AI_PLAYERBOT_MIN_RANDOM_BOTS=$BOT_COUNT"
            -e "AC_AI_PLAYERBOT_MAX_RANDOM_BOTS=$BOT_COUNT" -e AC_AI_PLAYERBOT_RANDOM_BOT_ALLIANCE_RATIO=50
            -e AC_AI_PLAYERBOT_RANDOM_BOT_HORDE_RATIO=50 -e AC_AI_PLAYERBOT_RANDOM_BOT_JOIN_LFG=1
            -e AC_AI_PLAYERBOT_RANDOM_BOT_JOIN_BG=1)
    fi
    podman run "${world_args[@]}" "$WORLD_IMAGE" >/dev/null

    local stable_checks=0
    local world_status
    for _ in $(seq 1 300); do
        world_status="$(podman inspect -f '{{.State.Status}}' "$WORLD_CONTAINER" 2>/dev/null || true)"
        if [[ "$world_status" == exited || "$world_status" == dead ]]; then
            podman logs --tail 180 "$WORLD_CONTAINER" >&2 || true
            return 1
        fi
        if [[ "$world_status" == running ]] && port_ready 3724 && port_ready "$WORLD_PORT"; then
            stable_checks=$((stable_checks + 1))
            if (( stable_checks >= 5 )); then
                printf '%s\n' "$REALM_KEY" > "$RUNTIME/active-realm"
                printf '%s is ready.\n' "$REALM_NAME"
                return 0
            fi
        else
            stable_checks=0
        fi
        sleep 3
    done
    printf 'Timed out waiting for %s.\n' "$REALM_NAME" >&2
    return 1
}

console_server() {
    [[ "$(podman inspect -f '{{.State.Status}}' "$WORLD_CONTAINER" 2>/dev/null || true)" == running ]] || {
        printf 'The world server must be running before sending console commands.\n' >&2
        return 1
    }
    set +e
    { cat; sleep 1; printf '\020\021'; } | timeout 20 podman attach --sig-proxy=false "$WORLD_CONTAINER"
    local attach_status=${PIPESTATUS[1]}
    set -e
    [[ $attach_status -eq 0 || $attach_status -eq 124 ]]
}

case "${1:-status}" in
    start) start_server ;;
    stop) stop_server ;;
    restart) stop_server; start_server ;;
    status)
        if port_ready 3724 && port_ready "$WORLD_PORT"; then
            podman ps --filter "name=$WORLD_CONTAINER" --format '{{.Status}}'
        else
            printf 'Offline: auth or world port is unavailable.\n' >&2
            exit 1
        fi
        ;;
    logs) podman logs --tail "${2:-200}" "$WORLD_CONTAINER" ;;
    console) console_server ;;
    *) printf 'Usage: %s {start|stop|restart|status|logs|console}\n' "$0" >&2; exit 2 ;;
esac
