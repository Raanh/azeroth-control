			"click" { "activators" { "Full_Press" { "bindings" { "binding" "mouse_button RIGHT" } } } }
		}
		"settings" { "output_joystick" "2" "sensitivity" "120" }
	}
	"group"
	{
		"id"		"10"
		"mode"		"dpad"
		"name"		"L1 Camera Zoom"
		"inputs"
		{
			"dpad_north" { "activators" { "Full_Press" { "bindings" { "binding" "mouse_wheel SCROLL_UP, Zoom in" } } } }
			"dpad_east" { "activators" { "Full_Press" { "bindings" { "binding" "mouse_wheel SCROLL_UP, Zoom in" } } } }
			"dpad_south" { "activators" { "Full_Press" { "bindings" { "binding" "mouse_wheel SCROLL_DOWN, Zoom out" } } } }
			"dpad_west" { "activators" { "Full_Press" { "bindings" { "binding" "mouse_wheel SCROLL_DOWN, Zoom out" } } } }
		}
		"settings" { "requires_click" "0" "haptic_intensity_override" "0" }
	}
